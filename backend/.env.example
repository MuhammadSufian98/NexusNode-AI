APP_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=NexusNode
JWT_SECRET=your_jwt_secret_here
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=https://nexus-node-ai.vercel.app/,http://localhost:3000,http://127.0.0.1:3000

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Primary and fallback Groq models (comma-separated, in order of preference)
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,mixtral-8x7b-32768,gemma2-9b-it
# Optional max completion tokens constraint for low latency
GROQ_MAX_TOKENS=1024

GEMINI_API_KEY=your_gemini_api_key
